HOST=127.0.0.1
PORT=8000
POSTGRES_DB=storeguide
POSTGRES_USER=storeguide
POSTGRES_PASSWORD=storeguide
DATABASE_URL=postgresql://storeguide:storeguide@localhost:5433/storeguide
KB_DIR=data/kb
CHUNK_TARGET_WORDS=180
CHUNK_OVERLAP_WORDS=40
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_SECONDS=120
GENERATION_MODEL=gemma4:e4b
GENERATION_TIMEOUT_SECONDS=180
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CACHE_DIR=model-cache
MIN_RELEVANCE_SCORE=0.002
MIN_QUERY_TERM_COVERAGE=0.60
EVAL_HIT_RATE_THRESHOLD=0.90
EVAL_REFUSAL_THRESHOLD=1.00
EVAL_IN_CORPUS_ACCEPTANCE_THRESHOLD=0.95
LOG_FILE=logs/requests.jsonl
